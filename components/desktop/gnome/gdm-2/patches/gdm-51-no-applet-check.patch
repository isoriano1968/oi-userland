No panel applet check: gdm-49 removes the user-switch applet, the only user
of APPLET_CFLAGS/APPLET_LIBS, but configure still requires
libmatepanelapplet-4.0 (gdm-45) for every build. mate-panel delivers that
library 64-bit only (since 1.28), so the 32-bit build, which delivers gdm
itself, fails in configure. Drop the check together with the applet.

diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -59,7 +59,6 @@
 PANGO_REQUIRED_VERSION=1.3.0
 SCROLLKEEPER_REQUIRED_VERSION=0.1.4
 GCONF_REQUIRED_VERSION=2.31.1
-GNOME_PANEL_REQUIRED_VERSION=1.28.0
 LIBXKLAVIER_REQUIRED_VERSION=4.0
 LIBCANBERRA_GTK_REQUIRED_VERSION=0.4
 #FONTCONFIG_REQUIRED_VERSION=2.6.0
@@ -163,14 +162,6 @@
 AC_SUBST(SIMPLE_CHOOSER_CFLAGS)
 AC_SUBST(SIMPLE_CHOOSER_LIBS)
 
-PKG_CHECK_MODULES(APPLET,
-        dbus-glib-1 >= $DBUS_GLIB_REQUIRED_VERSION
-        gtk+-2.0 >= $GTK_REQUIRED_VERSION
-        libmatepanelapplet-4.0 >= $GNOME_PANEL_REQUIRED_VERSION
-)
-AC_SUBST(APPLET_CFLAGS)
-AC_SUBST(APPLET_LIBS)
-
 PLUGIN_LIBTOOL_FLAGS="-export_dynamic -module -avoid-version"
 AC_SUBST(PLUGIN_LIBTOOL_FLAGS)
 
