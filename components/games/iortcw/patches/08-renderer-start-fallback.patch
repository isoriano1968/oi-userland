@@ -1056,6 +1056,9 @@
 // shutdown client
 
 void CL_InitRef(void);
+qboolean CL_RendererStarting(void);
+// a renderer is in its initialisation: Com_Error leaves it to
+// CL_InitRenderer, which can fall back to another renderer
 // initialize renderer interface
 
 void CL_StartHunkUsers( qboolean rendererOnly );
--- iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/null/null_client.c.orig
+++ iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/null/null_client.c
@@ -99,6 +99,10 @@
 void CL_ShutdownAll(qboolean shutdownRef) {
 }
 
+qboolean CL_RendererStarting(void) {
+	return qfalse;
+}
+
 void CL_InitRef(void) {
 }
 
--- iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/qcommon/common.c.orig
+++ iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/qcommon/common.c
@@ -322,6 +322,16 @@
 
 	restartClient = com_gameClientRestarting && !( com_cl_running && com_cl_running->integer );
 
+	// An error inside a renderer's initialisation (e.g. its shaders do not
+	// link on this GPU) goes back to CL_InitRenderer, which can start
+	// another renderer. The usual cleanup would restart the same renderer
+	// and fail again ("recursive error").
+	if ( ( code == ERR_DROP || code == ERR_FATAL ) && CL_RendererStarting() ) {
+		Com_Printf( "********************\nERROR: %s\n********************\n", com_errorMessage );
+		com_errorEntered = qfalse;
+		longjmp( abortframe, -1 );
+	}
+
 	com_gameRestarting = qfalse;
 	com_gameClientRestarting = qfalse;
 
--- iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/client/cl_main.c.orig
+++ iortcw-438e7d413b5f7277187c35b032eb0ef9093ae778/SP/code/client/cl_main.c
@@ -30,6 +30,7 @@
 
 #include "client.h"
 #include <limits.h>
+#include <setjmp.h>
 
 #include "../sys/sys_local.h"
 #include "../sys/sys_loadlib.h"
@@ -3274,14 +3275,61 @@
 #endif
 }
 
+#ifdef USE_RENDERER_DLOPEN
+#define FALLBACK_RENDERER "opengl1"
+
+static qboolean cl_rendererStarting;
+extern jmp_buf abortframe;
+
+qboolean CL_RendererStarting( void ) {
+	return cl_rendererStarting;
+}
+#else
+qboolean CL_RendererStarting( void ) {
+	return qfalse;
+}
+#endif
+
 /*
 ============
 CL_InitRenderer
 ============
 */
 void CL_InitRenderer( void ) {
+#ifdef USE_RENDERER_DLOPEN
+	jmp_buf savedframe;
+
+	// If the renderer fails in its own initialisation (Com_Error sends that
+	// error here), shut it down and start the fallback renderer instead,
+	// as CL_InitRef does for a renderer library that does not load.
+	Com_Memcpy( savedframe, abortframe, sizeof( savedframe ) );
+	cl_rendererStarting = qtrue;
+	if ( setjmp( abortframe ) ) {
+		char failed[MAX_CVAR_VALUE_STRING];
+
+		cl_rendererStarting = qfalse;
+		Com_Memcpy( abortframe, savedframe, sizeof( abortframe ) );
+		Q_strncpyz( failed, cl_renderer->string, sizeof( failed ) );
+		if ( !Q_stricmp( failed, FALLBACK_RENDERER ) ) {
+			Com_Error( ERR_FATAL, "Renderer %s failed to start: %s", failed,
+				Cvar_VariableString( "com_errorMessage" ) );
+		}
+		Com_Printf( S_COLOR_YELLOW "WARNING: renderer %s failed to start (%s), "
+			"using " FALLBACK_RENDERER "\n", failed,
+			Cvar_VariableString( "com_errorMessage" ) );
+		CL_ShutdownRef();
+		Cvar_Set( "cl_renderer", FALLBACK_RENDERER );
+		CL_InitRef();
+		CL_InitRenderer();
+		return;
+	}
+#endif
 	// this sets up the renderer and calls R_Init
 	re.BeginRegistration( &cls.glconfig );
+#ifdef USE_RENDERER_DLOPEN
+	cl_rendererStarting = qfalse;
+	Com_Memcpy( abortframe, savedframe, sizeof( abortframe ) );
+#endif
 
 	// load character sets
 	cls.charSetShader = re.RegisterShader( "gfx/2d/bigchars" );
