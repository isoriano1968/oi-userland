libsync.h: <sys/ioccom.h> for _IOWR on illumos.

The sync_file ioctl numbers use _IOWR, which illumos defines in
<sys/ioccom.h> and does not get through <sys/ioctl.h>. Same as the
NetBSD/pkgsrc patch Mesa 21.3 carried on OpenIndiana. Upstreamable.

--- src/util/libsync.h.orig
+++ src/util/libsync.h
@@ -36,6 +36,9 @@
 #include <string.h>
 #include <sys/types.h>
 #include <sys/ioctl.h>
+#ifdef __sun
+#include <sys/ioccom.h>
+#endif
 #include <unistd.h>
 #include <stdlib.h>
 #include <time.h>
