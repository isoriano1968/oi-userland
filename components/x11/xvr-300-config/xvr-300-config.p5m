set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description value="Xorg configuration and MATE defaults for the Sun XVR-300 (Radeon RV370) for radeon KMS, tested on an Ultra 45. Keyboard: Sun Type 7 USB with US layout; edit /etc/X11/xorg.conf.d/60-xvr-300-keyboard.conf for another layout (European layouts: model sun_type7_euro_usb). A hand-written /etc/X11/xorg.conf takes precedence and has to be moved away."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

file path=etc/X11/xorg.conf.d/60-xvr-300-keyboard.conf mode=0644 preserve=renamenew
file path=etc/dconf/db/local.d/50-xvr-300 mode=0444

# revision 9 has the byte-order fixes and EXA
depend type=require fmri=pkg:/x11/server/xorg/driver/xorg-video-ati@6.14.6-2026.0.0.9
